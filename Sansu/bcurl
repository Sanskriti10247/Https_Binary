#!/usr/bin/env bash
# client launcher — ./bcurl [-v] host:port/path
# same trick as ./observe: plain javac, no maven needed for the binary client.
set -e
HERE="$(dirname "$0")"
OUT="$HERE/.classes"
mkdir -p "$OUT"
javac -d "$OUT" "$HERE"/src/main/java/bhttp/BhttpFrames.java \
               "$HERE"/src/main/java/bhttp/BhttpClient.java
exec java -cp "$OUT" bhttp.BhttpClient "$@"
