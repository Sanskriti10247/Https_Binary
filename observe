#!/usr/bin/env bash
# server launcher — keeps the assignment's CLI: ./observe ./www 9000
# compiles the dependency-free protocol classes with javac (no maven needed)
# and runs the binary server. spring boot (pom.xml) is only the debug mirror.
set -e
HERE="$(dirname "$0")"
OUT="$HERE/.classes"
mkdir -p "$OUT"
javac -d "$OUT" "$HERE"/src/main/java/bhttp/BhttpFrames.java \
               "$HERE"/src/main/java/bhttp/MimeUtil.java \
               "$HERE"/src/main/java/bhttp/BhttpServer.java
exec java -cp "$OUT" bhttp.BhttpServer "$@"
